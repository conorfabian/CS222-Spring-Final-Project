PORT=8787
CORS_ORIGIN=http://127.0.0.1:5174

# Proposal pipeline generation is API-required. The server returns an error
# instead of template content when these values are missing or the provider fails.
# Use one provider configuration at a time.
LLM_PROVIDER=gemini
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=replace_with_real_key
LLM_MODEL=gemini-2.5-flash

# OpenAI-compatible example:
# LLM_PROVIDER=openai-compatible
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=replace_with_real_key
# LLM_MODEL=gpt-4.1-mini
